# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
.Python
*.pyd

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Local Cython build artefacts (only the original .pyx files are tracked)
*.c
*.cpp
!engine/CythonCompiler/**/*.c
!engine/CythonCompiler/**/*.cpp

# Notebook checkpoints
.ipynb_checkpoints/

# OS noise
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# --- Pipeline data plane (Block 1) ----------------------------------------
# Raw and processed datasets are large and recreatable; do NOT track them.
# Keep folder structure with .gitkeep stubs (see data/raw/.gitkeep etc.).
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Outputs plane --------------------------------------------------------
# Per-user .npz dumps, per-model TSVs, statistical-validation tables/figures.
# Recomputable by re-running the experiments.
outputs/*
!outputs/.gitkeep

# Misc
*.tmp
*.bak
*.orig
outputs.snapshot_*
outputs.snapshot_round2_*
